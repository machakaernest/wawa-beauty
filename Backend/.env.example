# Copy this file to ".env" and fill in your MySQL credentials.

# --- MySQL connection ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=maison_lumiere

# --- API server ---
PORT=4000

# Comma-separated list of origins allowed to call the API (frontend + dashboard).
# Leave empty to allow all origins (development only).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
